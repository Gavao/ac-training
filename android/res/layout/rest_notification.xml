<?xml version="1.0" encoding="utf-8"?>
<!-- Notifica del recupero (app chiusa): conto alla rovescia grande, nei colori di AC Training -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D1712"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rest_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECUPERO"
            android:textColor="#BEF264"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rest_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#E6F4EA"
            android:textSize="15sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/rest_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="#4ADE80"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rest_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Via!"
        android:textColor="#4ADE80"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
